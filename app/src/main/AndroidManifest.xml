<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="edu.upc.dsa.dsa_android">

    <queries>
        <package android:name="com.UnityTechnologies.com.unity.template.urpblank" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.dsa_android"
        android:usesCleartextTraffic="true">

        <activity android:name=".RankingActivity"/>
        <activity
            android:name=".EventUsersActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".LogoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".SignupActivity"
            android:exported="false" />
        <activity
            android:name=".InicioLoginActivity"
            android:exported="false" />
        <activity
            android:name=".TiendaActivity"
            android:exported="false" />
        <activity
            android:name=".InventarioActivity"
            android:exported="false" />
        <activity
            android:name=".ExtrasActivity"
            android:exported="false" />
        <activity
            android:name=".EventosActivity"
            android:exported="false" />

        <activity
            android:name=".MyTeamActivity"
            android:exported="false" />

        <activity
            android:name=".Faq.FaqAssistantActivity"
            android:exported="false" />

    </application>

</manifest>