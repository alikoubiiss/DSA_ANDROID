<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/eventImage"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:src="@drawable/combined_logo"
        android:contentDescription="Imagen del evento" />

    <TextView
        android:id="@+id/eventName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        tools:text="Torneo de Torres" />

    <TextView
        android:id="@+id/eventDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CBD5E1"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        tools:text="Compite durante tres días y consigue puntos extra para tu equipo." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/eventStartDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FBBF24"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Inicio: 2026-06-02" />

        <TextView
            android:id="@+id/eventEndDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FBBF24"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="end"
            tools:text="Fin: 2026-06-05" />

    </LinearLayout>

    <Button
        android:id="@+id/eventButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="INSCRIBIRSE"
        android:textColor="#0F172A"
        android:textStyle="bold"
        android:background="@drawable/td_button_primary"
        android:layout_marginTop="12dp" />

</LinearLayout>