<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal pre-login con tower_bg y logo del BackFront -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tower_bg"
    tools:context=".MainActivity">

    <!-- Overlay oscuro -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC0F172A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card central -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/td_card_bg"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo real del BackFront -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/combined_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TowerDefense"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FBBF24"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido al juego"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="28dp" />

        <!-- Botón Iniciar Sesión verde -->
        <Button
            android:id="@+id/Login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/td_button_green"
            android:text="INICIAR SESIÓN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Botón Registrarse dorado -->
        <Button
            android:id="@+id/Singup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/td_button_primary"
            android:text="REGISTRARSE"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>