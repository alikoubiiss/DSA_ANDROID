<?xml version="1.0" encoding="utf-8"?>
<!-- Item inventario: réplica del panel inventory-list de shop.html del BackFront -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/td_card_bg">

    <!-- Icono objeto (como el size-14 del BackFront) -->
    <TextView
        android:id="@+id/textViewObjectIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="🎒"
        android:textSize="22sp"
        android:background="@drawable/td_input_bg"
        android:layout_marginEnd="12dp" />

    <!-- Nombre + tipo del objeto -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewObjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Nombre del Objeto" />

        <TextView
            android:id="@+id/textViewObjectDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            tools:text="TIPO" />

    </LinearLayout>

    <!-- Cantidad (como el "x ${item.cantidad}" del BackFront) -->
    <TextView
        android:id="@+id/textViewObjectQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/td_input_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#A78BFA"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        tools:text="x 3" />

</LinearLayout>