<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema TowerDefense: verde #22C55E y dorado #FBBF24, fondo oscuro #0F172A -->
    <style name="Theme.dsa_android" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary: verde TowerDefense -->
        <item name="colorPrimary">#22C55E</item>
        <item name="colorPrimaryVariant">#16A34A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary: dorado TowerDefense -->
        <item name="colorSecondary">#FBBF24</item>
        <item name="colorSecondaryVariant">#F59E0B</item>
        <item name="colorOnSecondary">#0F172A</item>
        <!-- Fondo oscuro -->
        <item name="android:windowBackground">@drawable/tower_bg</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
    </style>
</resources>