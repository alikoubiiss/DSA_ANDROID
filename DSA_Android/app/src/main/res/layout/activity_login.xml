<?xml version="1.0" encoding="utf-8"?>
<!-- Login: réplica exacta del login.html del BackFront en Android -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tower_bg"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Overlay: rgba(26,15,10,0.85) como en el BackFront -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Glass card: como .glass-panel del BackFront -->
            <LinearLayout
                android:id="@+id/login_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="48dp"
                android:background="@drawable/td_card_bg"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Logo (combined_logo.png) como en el BackFront -->
                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:src="@drawable/combined_logo"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="12dp" />

                <!-- Título: "Iniciar Sesión" en verde como el BackFront -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Iniciar Sesión"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#22C55E"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="24dp" />

                <!-- Label USUARIO en dorado, como BackFront -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USUARIO"
                    android:textSize="11sp"
                    android:textColor="#FBBF24"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/td_input_bg"
                    android:hint="@usuario"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#475569"
                    android:layout_marginBottom="16dp" />

                <!-- Label CONTRASEÑA en dorado -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTRASEÑA"
                    android:textSize="11sp"
                    android:textColor="#FBBF24"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/td_input_bg"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#475569"
                    android:layout_marginBottom="28dp" />

                <!-- Botón ENTRAR: verde como en BackFront -->
                <Button
                    android:id="@+id/btnLoginSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/td_button_green"
                    android:text="ENTRAR →"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="14dp" />

                <!-- Volver -->
                <Button
                    android:id="@+id/btnBackToMain"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/td_input_bg"
                    android:text="VOLVER"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>